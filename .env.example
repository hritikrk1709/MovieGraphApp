# Copy this file to .env and fill in your CognoDB Cloud connection details.
# Get these from console.cognodb.com after creating your free (c0) instance.
# NEVER commit the real .env file.

NEO4J__URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
NEO4J__USER=cognodb
NEO4J__PASSWORD=<your-generated-password>
